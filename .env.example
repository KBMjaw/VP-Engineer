# Copy to .env.local for local development (never commit real values).
# Supabase → Project Settings → API. Use the PUBLIC key only:
#   the publishable key (sb_publishable_...) or the legacy "anon" key.
# NEVER put the service_role / secret key or the database password in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: largest photo the admin may pick, in MB (before compression). Default 20.
VITE_MAX_UPLOAD_MB=20

# Optional: public site URL (used for password-reset redirects). Default: current origin.
VITE_SITE_URL=https://vp-engineers.vercel.app
